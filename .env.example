# DeepSeek（必填）
Deepseek_API_KEY=your_deepseek_api_key
Deepseek_BASE_URL=https://api.deepseek.com/v1

# PostgreSQL（必填；建议两个独立 database）
MVP_POSTGRES_DSN=postgresql://your_user:your_password@127.0.0.1:5432/wang_agent_mvp
MVP_MEM0_DSN=postgresql://your_user:your_password@127.0.0.1:5432/wang_agent_mvp_mem0

# Milvus（默认本机 Docker 端口）
MILVUS_URI=http://127.0.0.1:19530

# Neo4j（默认本机 Docker 端口）
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_AUTH=neo4j/your_password

# LangSmith（可选；仅显式运行 live/evaluation 测试时使用）
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=wang-agent-portfolio
LANGSMITH_TRACING=false

# 仅 RAPTOR 真实摘要测试需要
Deepseek_flash_MODEL=deepseek-v4-flash
